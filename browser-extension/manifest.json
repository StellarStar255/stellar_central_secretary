{
  "manifest_version": 3,
  "name": "Stellar 知识采集",
  "version": "0.1.9",
  "description": "将当前可见网页或对话保存为可导入知识秘书的文件。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:8768/*"
  ]
}
